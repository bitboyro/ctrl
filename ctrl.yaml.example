version: 1
project: my-app
operations:
  status: compose/status
  deploy: compose/deploy
  logs: compose/logs
  redeploy:
    uses: compose/redeploy
    aliases: [rd]
  cp: host/copy
  ssh-key-setup: host/ssh-key-setup
  ssh: host/ssh
targets:
  prod:
    host: "${VM_HOST}"
    user: deploy
    cwd: /opt/my-app
    host_key_policy: "yes"
    environment:
      COMPOSE_FILE: docker-compose.yml
